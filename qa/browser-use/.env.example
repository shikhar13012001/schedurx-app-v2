# ScheduRx Browser QA configuration.
# No LLM API key is required — journeys drive Chrome directly via the
# browser-harness CDP CLI (https://github.com/browser-use/browser-harness).
#
# Install the CLI once:
#   uv tool install --python 3.12 --upgrade --force browser-harness
# Then enable Chrome remote debugging (chrome://inspect/#remote-debugging).

QA_STAFF_URL=https://app.schedurx.com
QA_PATIENT_BASE_URL=https://book.schedurx.com
QA_CLINIC_ID=poc-clinic-001
QA_CLINIC_NAME=Dr. Sharma's Clinic
QA_DOCTOR_NAME=Rahul Mehta
QA_EXPECTED_TOKEN_RUPEES=120
QA_TIMEZONE=Asia/Kolkata

# Keep false unless you intentionally want image/video artifacts that may
# contain patient data. Text reports are always written and redact identifiers.
QA_CAPTURE_GIF=false
QA_CAPTURE_VIDEO=false
QA_BROWSER_CHANNEL=chrome
QA_MAX_STEPS=80