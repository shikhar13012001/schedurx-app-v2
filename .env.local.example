# Backend origin this app talks to for everything except its own thin
# server-side proxy routes (onboarding, invite accept).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4005

# Firebase client (Web) config — same project as the backend's FIREBASE_PROJECT_ID.
# Public by design (Firebase security is enforced by rules + token verification,
# not by hiding this config) — see https://firebase.google.com/docs/projects/api-keys.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only — used by src/app/api/onboarding/route.ts to call the backend's
# bootstrap-only POST /internal/clinic. Must match the backend's INTERNAL_API_KEY
# exactly. NEVER prefix this with NEXT_PUBLIC_ — it must not reach the browser.
INTERNAL_API_KEY=

# Server-only — Firebase Admin SDK credentials, same project as above. Used by
# src/lib/firebase-admin.ts to verify a caller's real ID token server-side
# before /api/onboarding or /api/invite/[token]/accept ever trust a uid —
# never prefix these with NEXT_PUBLIC_. FIREBASE_PRIVATE_KEY_BASE64 is base64
# of the raw PEM (real newlines, before escaping) — safer than the literal-\n
# form on platforms whose env-var storage mangles backslash escapes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# Supabase project URL (public, safe to expose) — used client-side for the
# Realtime queue subscription in src/lib/realtime.ts.
NEXT_PUBLIC_SUPABASE_URL=

# The Supabase "anon public" key (Project Settings → API — NOT the
# service-role key). Without it, the queue falls back to 30s polling.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables real push-notification registration (sw.js already
# handles the push event). Generate with `npx web-push generate-vapid-keys`
# on the backend and use the same public key here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional — error tracking (see sentry.*.config.ts). Both dsn vars are
# inert/no-op if left unset; ORG/PROJECT/AUTH_TOKEN only affect uploading
# source maps at build time, not runtime error reporting.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
