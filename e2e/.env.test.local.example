# Copy this file to .env.test.local (gitignored) and fill in real values.

# Must match TEST_AUTH_SECRET as configured in Vercel's production env vars.
TEST_AUTH_SECRET=

# The backend's INTERNAL_API_KEY (from the droplet's .env) — lets the suite
# create/purge its own "[E2E]"-prefixed test clinics directly. Same secret,
# same trust level as any other /internal/* caller.
E2E_INTERNAL_API_KEY=

# Optional overrides — only needed for local dev against a different target.
# E2E_BASE_URL=https://app.schedurx.com
# E2E_API_BASE_URL=https://api.schedurx.com
